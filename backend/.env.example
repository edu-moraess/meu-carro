# Configurações do Ambiente Meu Carro
ENVIRONMENT=development
DEBUG=True
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meucarro
# Ou para SQLite local:
# DATABASE_URL=sqlite:///./meu_carro.db

# Chave JWT Secreta (Altere em Produção)
JWT_SECRET=super_secret_jwt_key_meu_carro_2026_prod

# Google Gemini API (Configurada no backend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
RATE_LIMIT_AI_PER_MINUTE=10

# Armazenamento (S3 ou Local)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=meu-carro-receipts
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LOCAL_STORAGE_DIR=./uploads
